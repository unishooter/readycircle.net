# Copy this file to .env and adjust values for your environment.
# Do not commit real secrets.

# --- Core ---
NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_PORT=3000

# --- Database ---
# Local Docker default (see docker-compose.yml)
DATABASE_URL=postgres://readycircle:readycircle_dev_password@localhost:5432/readycircle

# --- Sessions ---
# Generate a long random value for production, e.g. `openssl rand -hex 32`
SESSION_SECRET=dev-only-change-me-dev-only-change-me

# --- Logging ---
LOG_LEVEL=info

# --- AWS (production) ---
AWS_REGION=us-east-1
AWS_S3_DOCUMENT_BUCKET=
AWS_SQS_PLAN_QUEUE_URL=
AWS_SQS_DOCUMENT_QUEUE_URL=

# --- Cognito (Google + email/password sign-in) ---
# Optional in development/test (leave blank to use dev-auth only), but the
# API refuses to start with APP_ENV=production unless all five are set --
# see docs/deployment/cognito-google-setup.md for how to obtain them, and
# use http://localhost:3000/api/v1/auth/callback as the local redirect URI.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=

# --- AI plan generation ---
# Required in production; in development a missing key makes plan generation
# fail with a clear error instead of blocking startup. OPENAI_MODEL can be any
# model that supports Structured Outputs (strict JSON schema).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# --- Plan document storage ---
# When AWS_S3_DOCUMENT_BUCKET is blank (local development), rendered plan PDFs
# are written under this directory instead. Relative to the process cwd.
DOCUMENT_STORAGE_PATH=.data/documents

# --- Geocoding (broad-area location search) ---
# Identifies this app to OpenStreetMap Nominatim's public API, per its usage
# policy. A default is provided so this works out of the box in development;
# set a real monitored address in production.
GEOCODING_CONTACT_EMAIL=support@readycircle.net

# --- Development authentication ---
# Must never be true in a production deployment. The API refuses to start
# with this enabled when APP_ENV=production unless DEV_AUTH_UNSAFE_OVERRIDE=true.
DEV_AUTH_ENABLED=true
DEV_AUTH_UNSAFE_OVERRIDE=false
