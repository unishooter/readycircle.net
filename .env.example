# Copy this file to .env and adjust values for your environment.
# Do not commit real secrets.

# --- Core ---
NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_PORT=3000

# --- Database ---
# Local Docker default (see docker-compose.yml)
DATABASE_URL=postgres://readycircle:readycircle_dev_password@localhost:5432/readycircle

# --- Sessions ---
# Generate a long random value for production, e.g. `openssl rand -hex 32`
SESSION_SECRET=dev-only-change-me-dev-only-change-me

# --- Logging ---
LOG_LEVEL=info

# --- AWS (production) ---
AWS_REGION=us-east-1
AWS_S3_DOCUMENT_BUCKET=
AWS_SQS_PLAN_QUEUE_URL=
AWS_SQS_DOCUMENT_QUEUE_URL=

# --- Cognito (production identity provider, not required in development) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=

# --- Development authentication ---
# Must never be true in a production deployment. The API refuses to start
# with this enabled when APP_ENV=production unless DEV_AUTH_UNSAFE_OVERRIDE=true.
DEV_AUTH_ENABLED=true
DEV_AUTH_UNSAFE_OVERRIDE=false
